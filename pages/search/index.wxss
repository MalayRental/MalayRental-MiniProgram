@import "../home/index.wxss";

.search-container-bg {
  min-height: 100vh;
  width: 100%;
  background: linear-gradient(180deg, #4ac924 0%, #f2faf2 30%, #f6f6f6 100%);
  box-sizing: border-box;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
}

.guess-section, .hot-section {
  margin: 32rpx 24rpx 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  background: #f2faf2;
  color: #4ac924;
  border-radius: 32rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.tag.hot {
  background: #fff7e6;
  color: #ff9900;
}

.empty-image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 24rpx;
} 