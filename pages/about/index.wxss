/* 关于马来租房页面样式 */
.page-container {
  padding: 30rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #4ac924 0%, #f2faf2 30%, #f6f6f6 100%);
}

.content {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.app-logo {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
}

.app-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.app-version {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.divider {
  height: 1rpx;
  background-color: #eee;
  margin: 30rpx 0;
}

.about-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #4ac924;
}

.section-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  text-align: justify;
}

.feature-list {
  margin-top: 20rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.feature-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.feature-text {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}

.contact-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.contact-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.contact-text {
  font-size: 26rpx;
  color: #666;
}

.button-group {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
}

.about-button {
  width: 48%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.primary-button {
  background-color: #4ac924;
  color: #fff;
}

.secondary-button {
  background-color: #f2faf2;
  color: #4ac924;
  border: 1rpx solid #4ac924;
}

.placeholder {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
} 