        </view>
        <view class="feature-item">
          <image class="feature-icon" src="/assets/icons/chat-black.png" mode="aspectFit"></image>
          <view class="feature-text">与中国员工直接沟通，免除语言障碍</view>
        </view>
        <view class="feature-item">
