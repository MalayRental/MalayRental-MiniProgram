/* 登录页面样式 */
.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #4ac924 0%, #f2faf2 30%, #f6f6f6 100%);
  padding: 0 30rpx;
  box-sizing: border-box;
}

/* Logo样式 */
.logo-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
  margin-bottom: 60rpx;
}

.logo-image {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
}

.logo-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 表单样式 */
.login-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.input-item {
  display: flex;
  align-items: center;
  height: 90rpx;
  border-bottom: 1rpx solid #e0e0e0;
  margin-bottom: 30rpx;
  position: relative;
  overflow: hidden;
}

.input-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2rpx;
  background-color: #4ac924;
  transition: width 0.3s ease;
}

.input-item.focus::after {
  width: 100%;
}

.input-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
}

.form-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
}

.input-placeholder {
  color: #999999;
}

/* 按钮样式 */
.login-button {
  margin-top: 60rpx;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(90deg, #4ac924 0%, #3db91f 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 45rpx;
  box-shadow: 0 6rpx 12rpx rgba(74, 201, 36, 0.2);
  border: none;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
}

.button-hover {
  opacity: 0.8;
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 8rpx rgba(74, 201, 36, 0.2);
}

.wechat-login-button {
  margin-top: 30rpx;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(90deg, #07c160 0%, #06ad55 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 12rpx rgba(7, 193, 96, 0.2);
  border: none;
  padding: 0;
}

.wechat-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

/* 底部链接 */
.bottom-links {
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
  width: 100%;
}

.link {
  font-size: 26rpx;
  color: #666666;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background-color: rgba(255, 255, 255, 0.6);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

/* 协议区域 */
.agreement {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #999999;
  padding: 20rpx;
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 10rpx;
}

.agreement-text {
  margin-left: 10rpx;
}

.link-text {
  color: #4ac924;
} 