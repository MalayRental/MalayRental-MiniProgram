/* pages/login/index.wxss */
.login-container {
  min-height: 100vh;
  background-color: #f8f8f8;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.login-content {
  flex: 1;
  padding: 0 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx;
}

.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.logo-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
  margin-bottom: 20rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  background-color: #fff;
}

.app-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 16rpx;
  color: #333;
}

.welcome-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-top: 10rpx;
}

.form-container {
  width: 100%;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
  margin-bottom: 40rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

/* 自定义输入框样式 */
.custom-input {
  background-color: #f5f7fa !important;
  border-radius: 12rpx !important;
  border: none !important;
  padding: 4rpx 16rpx !important;
}

/* 输入提示样式 */
.input-tip {
  font-size: 22rpx;
  color: #888;
  margin: 8rpx 0 0 8rpx;
}

/* 缩小输入框内的图标和文字 */
.t-input__icon {
  font-size: 36rpx !important;
  color: #0052D9 !important;
}

.t-input__control {
  font-size: 26rpx !important;
  height: 70rpx !important;
}

.t-input__placeholder {
  font-size: 26rpx !important;
  color: #aaa !important;
}

.error-message {
  color: #e34d59;
  font-size: 26rpx;
  margin: 0rpx 0 24rpx;
  font-weight: 500;
}

.button-group {
  margin-top: 40rpx;
}

.login-button {
  height: 88rpx !important;
  font-size: 30rpx !important;
  background-color: #0052D9 !important;
  border-radius: 12rpx !important;
  font-weight: 500 !important;
}

.register-link {
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #666;
}

.link {
  color: #0052D9;
  margin-left: 10rpx;
}

/* 底部说明文字 */
.footer-text {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: auto;
  padding: 30rpx 0;
}

.login-button {
  margin-top: 40rpx;
}

/* 微信登录按钮样式 */
.wechat-button {
  margin-top: 30rpx !important;
  background-color: #07C160 !important;
  color: white !important;
  border-radius: 12rpx !important;
  height: 88rpx !important;
  font-size: 32rpx !important;
  border: none !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  outline: none !important;
}

.wechat-button::after {
  border: none !important;
  outline: none !important;
  box-shadow: none !important;
}

.wechat-button .t-icon {
  margin-right: 10rpx;
}

/* 绑定提示样式 */
.bind-tip {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-top: 20rpx;
} 