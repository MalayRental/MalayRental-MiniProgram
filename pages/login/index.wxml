<!--pages/login/index.wxml-->
<view class="login-container">
  <!-- 自定义导航栏 -->
  <custom-navbar title="登录" showBack="{{true}}" bind:back="goBack" bind:heightChange="onNavBarHeightChange"></custom-navbar>

  <view class="login-content" style="margin-top: {{navBarHeight ? navBarHeight + 20 : 20}}rpx;">
    <view class="header-section">
      <view class="logo-container">
        <!-- 使用图标替代图片，避免网络请求 -->
        <t-icon name="user-avatar" size="80rpx" class="logo" />
        <text class="app-name">大马租房</text>
      </view>
      <text class="welcome-text">欢迎登录</text>
    </view>

    <view class="form-container">
      <!-- 账号输入 -->
      <view class="input-group">
        <view class="input-label">手机号</view>
        <t-input
          placeholder="请输入手机号"
          value="{{account}}"
          bindchange="onAccountInput"
          prefixIcon="mobile"
          clearable
          type="number"
          maxlength="11"
          t-class="custom-input"
        />
        <view class="input-tip">请使用中国大陆手机号</view>
      </view>

      <!-- 密码输入 -->
      <view class="input-group">
        <view class="input-label">密码</view>
        <t-input
          placeholder="请输入密码"
          value="{{password}}"
          bindchange="onPasswordInput"
          prefixIcon="lock-on"
          clearable
          type="password"
          t-class="custom-input"
        />
      </view>

      <!-- 错误信息 -->
      <view class="error-message" wx:if="{{errorMessage}}">
        {{errorMessage}}
      </view>

      <!-- 登录按钮 -->
      <view class="button-group">
        <t-button
          t-class="login-button"
          theme="primary"
          size="large"
          block
          loading="{{isLoading}}"
          bindtap="login"
        >
          登录
        </t-button>
        
        <!-- 微信登录按钮 -->
        <t-button
          t-class="wechat-button"
          theme="primary"
          size="large"
          block
          loading="{{isWxLoading}}"
          bindtap="wxLogin"
        >
          <t-icon name="logo-wechat" size="44rpx" />
          <text>微信快捷登录</text>
        </t-button>
      </view>

      <!-- 注册入口 -->
      <view class="register-link">
        <text>还没有账号？</text>
        <text class="link" bindtap="goToRegister">立即注册</text>
      </view>
    </view>
    
    <!-- 底部说明 -->
    <view class="footer-text">
      <text>登录即代表您已同意</text>
      <text class="link">《用户协议》</text>
      <text>和</text>
      <text class="link">《隐私政策》</text>
    </view>
  </view>
</view>

<t-toast id="t-toast" /> 