<!--pages/login/register.wxml-->
<view class="register-container">
  <!-- 自定义导航栏 -->
  <custom-navbar title="注册" showBack="{{true}}" bind:back="goToLogin" bind:heightChange="onNavBarHeightChange"></custom-navbar>

  <view class="register-content" style="margin-top: {{navBarHeight ? navBarHeight + 20 : 20}}rpx;">
    <view class="header-section">
      <view class="welcome-text">新用户注册</view>
      <view class="sub-title">创建您的大马租房账号</view>
    </view>

    <view class="form-container">
      <!-- 用户名输入 -->
      <view class="input-group">
        <view class="input-label">用户名</view>
        <t-input
          placeholder="请输入用户名（不超过32个字）"
          value="{{username}}"
          bindchange="onUsernameInput"
          prefixIcon="user"
          clearable
          maxlength="32"
          t-class="custom-input"
        />
        <view class="input-tip">用户名最多32个字</view>
      </view>

      <!-- 账号输入 -->
      <view class="input-group">
        <view class="input-label">手机号</view>
        <t-input
          placeholder="请输入手机号"
          value="{{account}}"
          bindchange="onAccountInput"
          prefixIcon="mobile"
          clearable
          type="number"
          maxlength="11"
          t-class="custom-input"
        />
        <view class="input-tip">请使用中国大陆手机号</view>
      </view>

      <!-- 密码输入 -->
      <view class="input-group">
        <view class="input-label">密码</view>
        <t-input
          placeholder="请输入密码"
          value="{{password}}"
          bindchange="onPasswordInput"
          prefixIcon="lock-on"
          clearable
          type="password"
          t-class="custom-input"
        />
        <view class="input-tip">密码至少8位，必须包含大小写字母和数字</view>
      </view>

      <!-- 确认密码输入 -->
      <view class="input-group">
        <view class="input-label">确认密码</view>
        <t-input
          placeholder="请再次输入密码"
          value="{{confirmPassword}}"
          bindchange="onConfirmPasswordInput"
          prefixIcon="lock-on"
          clearable
          type="password"
          t-class="custom-input"
        />
      </view>

      <!-- 错误信息 -->
      <view class="error-message" wx:if="{{errorMessage}}">
        {{errorMessage}}
      </view>

      <!-- 注册按钮 -->
      <view class="button-group">
        <t-button
          t-class="register-button"
          theme="primary"
          size="large"
          block
          loading="{{isLoading}}"
          bindtap="register"
        >
          注册
        </t-button>
      </view>

      <!-- 登录入口 -->
      <view class="login-link">
        <text>已有账号？</text>
        <text class="link" bindtap="goToLogin">立即登录</text>
      </view>
    </view>
    
    <!-- 底部说明 -->
    <view class="footer-text">
      <text>注册即代表您已同意</text>
      <text class="link">《用户协议》</text>
      <text>和</text>
      <text class="link">《隐私政策》</text>
    </view>
  </view>
</view>

<t-toast id="t-toast" /> 