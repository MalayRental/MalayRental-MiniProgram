/* 聊天页面样式 */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f6f6f6;
  box-sizing: border-box;
  padding-top: 0; /* 导航栏有自己的占位元素 */
  position: fixed; /* 固定整个容器 */
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden; /* 防止内容溢出 */
}

/* 联系人信息 */
.contact-info {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e0e0e0;
  width: 100%;
  box-sizing: border-box;
  height: 128rpx; /* 固定高度 */
  flex-shrink: 0; /* 不要被压缩 */
}

.contact-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.contact-details {
  flex: 1;
}

.contact-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.contact-id {
  font-size: 24rpx;
  color: #999;
}

.contact-status {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border-radius: 24rpx;
}

.online {
  background-color: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.offline {
  background-color: rgba(170, 170, 170, 0.1);
  color: #aaa;
}

/* 消息列表 */
.message-list {
  flex: 1; /* 占满剩余空间 */
  box-sizing: border-box;
  overflow-y: scroll;
  padding-left: 8px;
  padding-right: 8px;
  width: 100%;
}

/* 消息列表内容 */
.message-list-content {
  padding: 30rpx 15rpx;
  padding-bottom: 28px;
  box-sizing: border-box;
  width: 100%;
}

/* 消息项目 */
.message-item {
  display: flex;
  align-items: flex-end;
  margin-bottom: 40rpx;
  position: relative;
  max-width: 100%;
}

.message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  flex-shrink: 0;
}

.my-message {
  flex-direction: row-reverse;
}

.my-avatar {
  margin-left: 20rpx;
}

.other-avatar {
  margin-right: 20rpx;
}

.bubble-time-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 60%;
}

.my-bubble-time {
  align-items: flex-end;
}

.other-bubble-time {
  align-items: flex-start;
}

.message-bubble {
  max-width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  word-wrap: break-word;
  position: relative;
}

.my-bubble {
  background-color: #4ac924;
  color: #fff;
  border-top-right-radius: 0;
}

.other-bubble {
  background-color: #fff;
  color: #333;
  border-top-left-radius: 0;
}

.message-content {
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.message-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  width: auto;
  text-align: left;
  position: static;
  align-self: flex-start;
}

.my-time {
  text-align: right;
  align-self: flex-end;
}

.other-time {
  text-align: left;
  align-self: flex-start;
}

/* 消息卡片样式 */
.message-card {
  max-width: 380rpx; 
  padding: 16rpx;
  border-radius: 16rpx;
  word-wrap: break-word;
  position: relative;
  background-color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  border: 1rpx solid #f0f0f0;
  margin: 0 0 8rpx 0;
  display: flex;
  flex-direction: column;
}

.my-card {
  background-color: #f8fcf7;
  border-bottom-right-radius: 0;
}

.other-card {
  background-color: #fff;
  border-bottom-left-radius: 0;
}

.message-card .message-card-cover {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  object-fit: cover;
  margin-bottom: 16rpx;
}

.message-card .card-content {
  padding: 0 10rpx;
}

.message-card .card-name {
  font-size: 36rpx; /* 放大房源名称字体 */
  color: #222;
  font-weight: 600;
  margin-bottom: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.message-card .card-area {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.message-card .card-bottom-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 6rpx;
}

.message-card .card-price {
  font-size: 34rpx;
  color: #f5222d;
  font-weight: 700;
  margin-right: 46rpx;
}

.message-card .card-view-btn {
  font-size: 25rpx;
  color: #ffffff;
  background-color: #4ac924;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  margin-left: auto;
}

/* 输入框容器 */
.input-container {
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom, 0px) / 2);
  background-color: #ffffff;
  min-height: 112rpx;
  box-sizing: border-box;
  width: 100%;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  border-top: 1rpx solid #e0e0e0;
}

.message-input {
  flex: 1;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.input-placeholder {
  color: #999;
}

.send-button {
  width: 120rpx;
  height: 72rpx;
  background-color: #4ac924;
  color: #ffffff;
  border-radius: 36rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  margin-left: 16rpx;
}

/* 房源卡片样式 */
.want-house-card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.08);
  margin: 0;
  padding: 20rpx 24rpx;
  position: fixed;
  bottom: 140rpx; /* 增加与输入框的间距 */
  left: 24rpx;
  right: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 120rpx;
  z-index: 101;
}
.card-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.card-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 580;
}
.card-close {
  width: 36rpx;
  height: 36rpx;
}
.card-content-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
}
.card-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  object-fit: cover;
  margin-right: 20rpx;
}
.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.card-name {
  font-size: 30rpx;
  color: #222;
  font-weight: 500;
  margin-bottom: 8rpx;
}
.card-area {
  font-size: 26rpx;
  color: #666;
}
.card-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}
.card-price {
  font-size: 28rpx;
  color: #f5222d;
  font-weight: 600;
}
.card-send-btn {
  background-color: #4ac924;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 36rpx; /* 与发送按钮相同的半圆形效果 */
  padding: 10rpx 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(74, 201, 36, 0.2);
} 