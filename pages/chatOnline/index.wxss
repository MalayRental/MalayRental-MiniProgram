/* 聊天页面样式 */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f6f6f6;
  box-sizing: border-box;
  padding-top: 0; /* 导航栏有自己的占位元素 */
  position: fixed; /* 固定整个容器 */
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden; /* 防止内容溢出 */
}

/* 联系人信息 */
.contact-info {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e0e0e0;
  width: 100%;
  box-sizing: border-box;
  height: 128rpx; /* 固定高度 */
  flex-shrink: 0; /* 不要被压缩 */
}

.contact-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.contact-details {
  flex: 1;
}

.contact-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.contact-id {
  font-size: 24rpx;
  color: #999;
}

.contact-status {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border-radius: 24rpx;
}

.online {
  background-color: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.offline {
  background-color: rgba(170, 170, 170, 0.1);
  color: #aaa;
}

/* 消息列表 */
.message-list {
  flex: 1; /* 占满剩余空间 */
  box-sizing: border-box;
  overflow-y: scroll;
  padding-left: 8px;
  padding-right: 8px;
  width: 100%;
}

/* 消息列表内容 */
.message-list-content {
  padding: 30rpx 15rpx;
  padding-bottom: 28px;
  box-sizing: border-box;
  width: 100%;
}

/* 消息项目 */
.message-item {
  display: flex;
  align-items: flex-end;
  margin-bottom: 40rpx;
  position: relative;
  max-width: 100%;
}

.message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  flex-shrink: 0;
}

.my-message {
  flex-direction: row-reverse;
}

.my-avatar {
  margin-left: 20rpx;
}

.other-avatar {
  margin-right: 20rpx;
}

.bubble-time-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 60%;
}

.my-bubble-time {
  align-items: flex-end;
}

.other-bubble-time {
  align-items: flex-start;
}

.message-bubble {
  max-width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  word-wrap: break-word;
  position: relative;
}

.my-bubble {
  background-color: #4ac924;
  color: #fff;
  border-top-right-radius: 0;
}

.other-bubble {
  background-color: #fff;
  color: #333;
  border-top-left-radius: 0;
}

.message-content {
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.message-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  width: auto;
  text-align: left;
  position: static;
  align-self: flex-start;
}

.my-time {
  text-align: right;
  align-self: flex-end;
}

.other-time {
  text-align: left;
  align-self: flex-start;
}

/* 底部输入框 */
.input-container {
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom, 0px) / 2); /* 减小安全区域高度，只使用一半 */
  background-color: #ffffff;
  border-top: 1rpx solid #e0e0e0;
  width: 100%;
  min-height: 112rpx; /* 最小高度，确保内容不被挤压 */
  box-sizing: border-box;
  flex-shrink: 0; /* 不要被压缩 */
  position: fixed; /* 固定位置 */
  bottom: 0; /* 固定在底部 */
  left: 0;
  right: 0;
  z-index: 100; /* 确保在最上层 */
}

.message-input {
  flex: 1;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.input-placeholder {
  color: #999;
}

.send-button {
  width: 120rpx;
  height: 72rpx;
  background-color: #4ac924;
  color: #ffffff;
  border-radius: 36rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  margin-left: 16rpx;
} 