<view class="history-container">
  <!-- 自定义导航栏 -->
  <custom-navbar 
    title="浏览历史" 
    showBack="{{true}}" 
    solidGradient="{{true}}" 
    bind:heightChange="onNavBarHeightChange"
    backUrl="/pages/mine/index"
    useTabBack="{{true}}"
  ></custom-navbar>

  <!-- 加载中提示 -->
  <view class="loading-container" wx:if="{{loading}}">
    <t-loading theme="circular" size="40rpx" loading="{{loading}}" />
  </view>
  
  <!-- 错误提示 -->
  <view class="error-container" wx:if="{{error && !loading}}">
    <t-icon name="error-circle" size="80rpx" />
    <view class="error-text">{{error}}</view>
    <t-button size="small" theme="primary" bindtap="fetchHistory">重新加载</t-button>
  </view>
  
  <!-- 浏览历史列表（按天分组） -->
  <block wx:if="{{groupedHistory.length > 0 && !loading && !error}}">
    <view class="history-list" style="padding-top: {{navBarHeight - 45}}rpx;">
      <!-- 遍历日期组 -->
      <block wx:for="{{groupedHistory}}" wx:key="date" wx:for-item="group">
        <!-- 日期标题 -->
        <view class="date-header">
          <text class="date-label">{{group.dateLabel}}</text>
          <view class="date-line"></view>
        </view>
        
        <!-- 该日期下的房源列表 -->
        <block wx:for="{{group.items}}" wx:key="id">
          <view class="house-item" bindtap="onHouseClick" data-id="{{item.id}}">
            <view class="house-item-content">
              <view class="house-img-container">
                <image src="{{item.images[0]}}" class="house-img" mode="aspectFill" />
              </view>
              <view class="house-info">
                <view class="house-title">{{item.title}}</view>
                <view class="house-price">{{item.price}}{{item.priceUnit}}</view>
                <view class="house-info-line">
                  <text>{{item.area || '未知区域'}} | {{item.paymentMethod || '月付'}} | {{item.roomType || (item.room + '室1厅')}}</text>
                </view>
                <view class="house-address">{{item.address}}</view>
                <view class="house-tags">
                  <t-tag wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" size="small" wx:for-index="tagIndex" wx:if="{{tagIndex < 3}}" variant="light" class="tag">{{tag}}</t-tag>
                </view>
              </view>
            </view>
          </view>
        </block>
      </block>
    </view>
  </block>
  
  <!-- 空状态 -->
  <view class="empty-container" wx:if="{{!loading && !error && groupedHistory.length === 0}}" style="padding-top: {{navBarHeight ? 100 : 100}}rpx;">
    <t-icon name="time" size="120rpx" color="#BBBBBB" />
    <text>暂无浏览历史</text>
  </view>
</view> 