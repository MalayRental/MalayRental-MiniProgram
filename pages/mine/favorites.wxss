.favorites-container {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: linear-gradient(to bottom, #e0f4e8 0%, #ffffff 100%);
}

.house-list {
  background-color: transparent;
}

.house-item {
  padding: 20rpx 30rpx;
  margin: 0 30rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.house-item-content {
  display: flex;
  margin-bottom: 0;
  height: 220rpx;
}

.house-img-container {
  width: 220rpx;
  height: 220rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.house-img {
  width: 100%;
  height: 100%;
}

.house-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 220rpx;
  justify-content: space-between;
  overflow: hidden;
  padding-bottom: 0;
}

.house-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  line-height: 44rpx;
}

.house-price {
  color: #FF4D4F;
  font-weight: bold;
  font-size: 38rpx;
}

.house-info-line {
  font-size: 30rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.house-tags {
  display: flex;
  flex-wrap: nowrap;
  margin-bottom: 0;
  overflow: hidden;
  white-space: nowrap;
}

.tag {
  margin-right: 8rpx;
  font-size: 28rpx !important;
  padding: 4rpx 14rpx !important;
  flex-shrink: 0;
  display: inline-block;
}

.loading-container {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  text-align: center;
}

.error-text {
  color: #999;
  font-size: 28rpx;
  margin: 20rpx 0 30rpx;
}

.empty-container {
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 30rpx;
}

.empty-container text {
  margin-top: 30rpx;
} 