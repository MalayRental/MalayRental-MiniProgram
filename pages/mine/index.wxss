/* 我的页面样式 */
.mine-container {
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #4ac924 0%, #f2faf2 30%, #f6f6f6 100%);
  min-height: 100vh;
}

/* 用户信息区域 */
.user-info-container {
  background: transparent;
  padding: 60rpx 40rpx 60rpx;
  position: relative;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-info.not-login {
  opacity: 0.85;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(240, 240, 240, 0.6);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.user-details {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 26rpx;
  color: #666;
}

.edit-icon {
  width: 40rpx;
  height: 40rpx;
}

.edit-icon image {
  width: 100%;
  height: 100%;
}

/* 收藏和历史区域 */
.collection-container {
  margin: -30rpx 30rpx 30rpx;
  position: relative;
  z-index: 10;
}

.collection-items {
  display: flex;
  justify-content: space-between;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx 0;
  box-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.05);
}

.collection-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.collection-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 12rpx;
}

.collection-text-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.collection-text {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.collection-count {
  font-size: 24rpx;
  color: #999;
}

/* 菜单区域 */
.menu-container {
  margin: 0 30rpx 30rpx;
}

.menu-items {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-content {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #ccc;
  border-right: 2rpx solid #ccc;
  transform: rotate(45deg);
}