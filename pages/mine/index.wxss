/* pages/mine/index.wxss */
.mine-container {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: linear-gradient(to bottom, #e0f4e8 0%, #ffffff 100%);
}

.user-info-section {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx;
  background-color: transparent;
  border-bottom: 1rpx solid rgba(245, 245, 245, 0.5);
  border-radius: 12rpx;
  position: relative;
}

.user-info-section::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: transparent;
  border-radius: 12rpx;
  transition: background-color 0.2s;
}

.user-info-section:active::after {
  background-color: rgba(0, 0, 0, 0.05);
}

.user-details {
  margin-left: 20rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 24rpx;
  color: #888;
}

.function-section {
  margin-top: 10rpx;
}

/* 卡片容器通用样式 */
.card-container {
  margin: 20rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.function-cards {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: transparent;
  position: relative;
}

.function-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 33.33%;
  height: 130rpx;
  background-color: transparent;
  border-radius: 0;
  padding: 15rpx 0;
  box-shadow: none;
  position: relative;
}

/* 移除分隔线 */
.function-card:not(:last-child)::after {
  display: none;
}

.function-card:active {
  background-color: rgba(240, 240, 240, 0.6);
}

.function-card text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #333;
}

.settings-card {
  margin-top: 30rpx;
}

.settings-group {
  background-color: transparent;
}

.logout-section {
  margin: 60rpx 40rpx;
}

/* 自定义退出按钮样式 */
.logout-button {
  background-color: #FF4D4F !important;
  border: none !important;
  border-radius: 20rpx !important;
  overflow: hidden;
  height: 90rpx !important;
  line-height: 90rpx !important;
  font-size: 32rpx !important;
  font-weight: bold !important;
  letter-spacing: 2rpx !important;
}

.cell-title {
  font-size: 28rpx !important;
}

/* 设置t-cell背景为透明 */
.settings-group .t-cell {
  background-color: transparent !important;
  margin: 0 !important;
}

/* 设置t-cell底部边框为半透明 */
.settings-group .t-cell::after {
  border-bottom: 1rpx solid rgba(245, 245, 245, 0.5) !important;
}

/* 移除最后一个cell的底部边框 */
.settings-group .t-cell:last-child::after {
  border-bottom: none !important;
}