<!-- 我的页面 -->
<navigation-bar title="我的" back="{{false}}" background="#4ac924" color="#fff"></navigation-bar>
<view class="mine-container">
  <!-- 用户信息 -->
  <view class="user-info-container">
    <!-- 已登录状态 -->
    <view class="user-info" bindtap="navigateToEdit" wx:if="{{isLoggedIn && userInfo}}">
      <image class="user-avatar" src="{{userInfo.avatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="user-details">
        <text class="user-name">{{userInfo.userName || '用户' + userInfo.userId}}</text>
        <text class="user-phone">{{formattedPhoneNumber}}</text>
      </view>
      <view class="edit-icon">
        <image src="/assets/icons/edit.png" mode="aspectFit"></image>
      </view>
    </view>
    
    <!-- 未登录状态 -->
    <view class="user-info not-login" bindtap="navigateToLogin" wx:else>
      <image class="user-avatar" src="/assets/images/default-avatar.png" mode="aspectFill"></image>
      <view class="user-details">
        <text class="user-name">未登录</text>
        <text class="user-phone">点击登录账号</text>
      </view>
      <view class="edit-icon">
        <image src="/assets/icons/edit.png" mode="aspectFit"></image>
      </view>
    </view>
  </view>
  
  <!-- 收藏和历史 -->
  <view class="collection-container">
    <view class="collection-items">
      <block wx:for="{{collections}}" wx:key="id">
        <view class="collection-item" bindtap="navigateToCollection" data-id="{{item.id}}">
          <image class="collection-icon" src="{{item.icon}}" mode="aspectFit"></image>
          <view class="collection-text-container">
            <text class="collection-text">{{item.text}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>
  
  <!-- 功能菜单 -->
  <view class="menu-container">
    <view class="menu-items">
      <block wx:for="{{menuItems}}" wx:key="id">
        <view class="menu-item" bindtap="navigateToMenuPage" data-url="{{item.url}}" data-needlogin="{{item.needLogin}}">
          <view class="menu-item-content">
            <image class="menu-icon" src="{{item.icon}}" mode="aspectFit"></image>
            <text class="menu-text">{{item.text}}</text>
          </view>
          <view class="menu-arrow"></view>
        </view>
      </block>
      
      <!-- 退出登录 -->
      <view class="menu-item logout-item" bindtap="handleLogout" wx:if="{{isLoggedIn}}">
        <view class="menu-item-content">
          <image class="menu-icon" src="/assets/icons/logout.png" mode="aspectFit"></image>
          <text class="menu-text logout-text">退出登录</text>
        </view>
        <view class="menu-arrow"></view>
      </view>
    </view>
  </view>
</view> 