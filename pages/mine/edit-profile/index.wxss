/* pages/mine/edit-profile/index.wxss */
.profile-container {
  min-height: 100vh;
  background-color: #f6f7f9;
  display: flex;
  flex-direction: column;
}

.profile-content {
  flex: 1;
  padding: 5rpx 20rpx;
  margin-top: -5rpx;
}

/* 卡片样式 */
.profile-card {
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.05);
  padding: 30rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.card-title {
  display: flex;
  align-items: center;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  margin-bottom: 15rpx;
}

.card-title text {
  font-size: 38rpx;
  font-weight: 600;
  color: #333;
  margin-left: 16rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 15rpx 0;
}

/* 微信头像选择器样式 */
.avatar-wrapper {
  padding: 0 !important;
  margin: 0 !important;
  background: none !important;
  border: none !important;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  width: 180rpx !important;
  height: 180rpx !important;
  border-radius: 50% !important;
  overflow: hidden !important;
}

.avatar-wrapper::after {
  border: none !important;
}

.user-avatar {
  width: 100% !important;
  height: 100% !important;
  border-radius: 50% !important;
}

.avatar-hint {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #666;
}

.form-section {
  width: 100%;
}

.form-item {
  padding: 20rpx 0 !important;
}

.cell-title {
  font-size: 28rpx !important;
  color: #333 !important;
  font-weight: normal !important;
  display: flex !important;
  align-items: center !important;
}

.nickname-icon {
  font-size: 32rpx !important;
  margin-right: 8rpx;
  color: #0052D9;
}

.cell-note {
  flex: 1;
}

/* 更小的图标 */
.small-icon {
  font-size: 30rpx !important;
}

/* 微信昵称输入框样式 */
.nickname-input {
  text-align: right;
  height: 44rpx;
  line-height: 44rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
  padding: 0;
}

/* 提示文本区域 */
.tips-section {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: rgba(0, 82, 217, 0.05);
  border-radius: 8rpx;
  margin-bottom: 30rpx;
}

.tips-section text {
  font-size: 24rpx;
  color: #666;
  margin-left: 10rpx;
  line-height: 1.4;
}

.btn-section {
  margin-top: 60rpx;
  padding: 0 20rpx;
  margin-bottom: 50rpx;
}

/* 输入框样式修改 */
.t-input {
  --td-input-vertical-padding: 0 !important;
}

/* 修改分隔线样式 */
.t-divider {
  margin: 0 !important;
  background-color: rgba(0, 0, 0, 0.04) !important;
} 