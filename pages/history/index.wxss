/* 浏览历史页面样式 */
.page-container {
  padding: 20rpx;
  padding-top: 60rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #4ac924 0%, #f2faf2 30%, #f6f6f6 100%);
}

/* 加载中样式 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 600rpx;
}

.loading {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #4ac924;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}

/* 空状态样式 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.action-button {
  width: 300rpx;
  height: 80rpx;
  background-color: #4ac924;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 顶部清空按钮样式 */
.top-actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 30rpx;
  margin-top: 10rpx;
}

.clear-all {
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background-color: rgba(255, 77, 79, 0.08);
  border-radius: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.clear-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.clear-all text {
  font-size: 28rpx;
  color: #ff4d4f;
}

/* 日期分组样式 */
.history-list {
  padding-bottom: 30rpx;
}

.date-header {
  display: flex;
  align-items: center;
  margin: 30rpx 0 20rpx;
}

.date-text {
  font-size: 34rpx;
  color: #333;
  font-weight: 600;
  margin-left: 10rpx;
}

/* 房源列表样式 */
.house-list {
  padding-bottom: 0rpx;
}

.house-item {
  display: flex;
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
  height: 220rpx;
}

.house-cover {
  width: 240rpx;
  height: 100%;
  flex-shrink: 0;
  object-fit: cover;
}

.house-info {
  flex: 1;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: calc(100% - 240rpx);
  box-sizing: border-box;
  overflow: hidden;
}

.house-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.house-area {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.house-details {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.house-orientation {
  margin-right: 16rpx;
}

.house-proportion {
  position: relative;
  padding-left: 16rpx;
}

.house-proportion::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 24rpx;
  background-color: #e0e0e0;
}

.house-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
} 