/* 意见反馈页面样式 */
.page-container {
  padding: 30rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #4ac924 0%, #f2faf2 30%, #f6f6f6 100%);
}

.content {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.header-image {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #666;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #f5222d;
  margin-right: 6rpx;
}

.form-input {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #eee;
  height: 80rpx;
  line-height: 80rpx;
  vertical-align: middle;
}

.form-textarea {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #eee;
  height: 240rpx;
  line-height: 40rpx;
}

.type-items {
  display: flex;
  flex-wrap: wrap;
}

.type-item {
  padding: 16rpx 30rpx;
  border-radius: 40rpx;
  background-color: #f9f9f9;
  font-size: 26rpx;
  color: #666;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}

.type-item.active {
  background-color: rgba(74, 201, 36, 0.1);
  color: #4ac924;
  border: 1rpx solid #4ac924;
}

.image-uploader {
  margin-top: 10rpx;
}

.upload-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.uploader-files {
  display: flex;
  flex-wrap: wrap;
}

.uploader-file {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 20rpx 20rpx 0;
}

.uploader-file-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.uploader-file-delete {
  position: absolute;
  right: -10rpx;
  top: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.uploader-file-delete::before,
.uploader-file-delete::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 4rpx;
  background-color: #fff;
  transform: rotate(45deg);
}

.uploader-file-delete::after {
  transform: rotate(-45deg);
}

.uploader-add {
  width: 160rpx;
  height: 160rpx;
  border: 1rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.uploader-add-icon {
  font-size: 60rpx;
  color: #ddd;
  line-height: 1;
  margin-bottom: 10rpx;
}

.uploader-add-text {
  font-size: 24rpx;
  color: #999;
}

.contact-info {
  display: flex;
  flex-direction: column;
}

.contact-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.submit-btn {
  background-color: #4ac924;
  color: #fff;
  border-radius: 45rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  width: 100%;
  text-align: center;
  margin-top: 40rpx;
}

.placeholder {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
} 