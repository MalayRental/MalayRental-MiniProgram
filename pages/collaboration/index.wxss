/* 与我们合作页面样式 */
.page-container {
  padding: 30rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #4ac924 0%, #f2faf2 30%, #f6f6f6 100%);
}

.content {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.header-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 28rpx;
  color: #666;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #4ac924;
}

.cooperation-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.item-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.item-content {
  flex: 1;
}

.item-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.item-desc {
  font-size: 24rpx;
  color: #666;
}

.contact-section {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 30rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.contact-item:last-child {
  margin-bottom: 0;
}

.contact-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.contact-info {
  font-size: 28rpx;
  color: #333;
}

.contact-button {
  background-color: #4ac924;
  color: #fff;
  border-radius: 45rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  width: 100%;
  text-align: center;
  margin-top: 40rpx;
}

.cooperation-button {
  background-color: #f2faf2;
  color: #4ac924;
  border: 2rpx solid #4ac924;
  border-radius: 45rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  width: 100%;
  text-align: center;
  margin-top: 20rpx;
}

.placeholder {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
} 