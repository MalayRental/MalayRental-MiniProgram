/* 账号资料页面样式 */
.page-container {
  padding: 30rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #4ac924 0%, #f2faf2 30%, #f6f6f6 100%);
}

.content {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 表单样式 */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #eee;
  height: 80rpx;
  line-height: 80rpx;
  vertical-align: middle;
}

.avatar-section {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  margin-bottom: 40rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.avatar-btn {
  font-size: 26rpx;
  color: #4ac924;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
}

.avatar-btn::after {
  border: none;
}

.submit-btn {
  background-color: #4ac924;
  color: #fff;
  border-radius: 45rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  width: 100%;
  text-align: center;
  margin-top: 60rpx;
}

.form-row {
  display: flex;
  justify-content: space-between;
}

.form-column {
  width: 48%;
}

.placeholder {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 文本区域特殊处理 */
textarea.form-input {
  height: 180rpx;
  line-height: 40rpx;
  padding: 20rpx;
} 