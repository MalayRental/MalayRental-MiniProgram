<!-- 账号资料页面 -->
<navigation-bar title="账号资料" back="{{true}}" background="#4ac924" color="#fff"></navigation-bar>
<view class="page-container">
  <view class="content">
    <view class="avatar-section">
      <image class="avatar" src="{{userInfo.avatarUrl || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
      <button class="avatar-btn" bindtap="chooseAvatar">更换头像</button>
    </view>
    
    <view class="form-group">
      <view class="form-label">昵称</view>
      <input class="form-input" value="{{userInfo.nickName}}" placeholder="请输入昵称" bindinput="inputNickname" />
    </view>

    <view class="form-group">
      <view class="form-label">姓名</view>
      <input class="form-input" value="{{userInfo.fullName}}" placeholder="请输入姓名" bindinput="inputFullName" />
    </view>
    
    <view class="form-row">
      <view class="form-column">
        <view class="form-group">
          <view class="form-label">性别</view>
          <picker class="form-input" bindchange="bindGenderChange" value="{{genderIndex}}" range="{{genders}}">
            <view>{{genders[genderIndex]}}</view>
          </picker>
        </view>
      </view>
      <view class="form-column">
        <view class="form-group">
          <view class="form-label">年龄</view>
          <input class="form-input" type="number" value="{{userInfo.age}}" placeholder="请输入年龄" bindinput="inputAge" />
        </view>
      </view>
    </view>
    
    <view class="form-group">
      <view class="form-label">手机号码</view>
      <input class="form-input" type="number" value="{{userInfo.phone}}" placeholder="请输入手机号码" bindinput="inputPhone" />
    </view>
    
    <view class="form-group">
      <view class="form-label">邮箱</view>
      <input class="form-input" value="{{userInfo.email}}" placeholder="请输入邮箱" bindinput="inputEmail" />
    </view>

    <view class="form-group">
      <view class="form-label">学校</view>
      <input class="form-input" value="{{userInfo.school}}" placeholder="请输入学校" bindinput="inputSchool" />
    </view>
    
    <view class="form-group">
      <view class="form-label">个人简介</view>
      <textarea class="form-input" style="height: 180rpx;" value="{{userInfo.bio}}" placeholder="请输入个人简介" bindinput="inputBio"></textarea>
    </view>
    
    <view class="submit-btn" bindtap="saveUserInfo">保存</view>
  </view>
</view> 