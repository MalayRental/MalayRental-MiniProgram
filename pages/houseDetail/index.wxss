/* 房源详情页样式 */
.house-detail-container {
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #4ac924 0%, #f2faf2 30%, #f6f6f6 100%);
  padding-bottom: 120rpx; /* 为底部操作栏留出空间 */
}

/* 轮播图样式 */
.banner-swiper {
  width: calc(100% - 60rpx);
  height: 420rpx;
  margin: 40rpx 30rpx 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 通用样式 */
.info-section,
.detail-section,
.facility-section,
.community-section,
.introduction-section,
.other-section {
  margin: 15rpx 30rpx;
  padding: 30rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background-color: #4ac924;
  border-radius: 4rpx;
}

/* 基本信息样式 */
.house-name {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.house-price {
  font-size: 40rpx;
  font-weight: 600;
  color: #f5222d;
  margin-bottom: 24rpx;
}

/* 标签样式 */
.tags-container {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.tag {
  font-size: 24rpx;
  color: #4ac924;
  background-color: rgba(74, 201, 36, 0.1);
  border-radius: 4rpx;
  padding: 6rpx 12rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

/* 基本信息项样式 */
.info-items {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 33.33%;
  margin-bottom: 16rpx;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

/* 详细信息样式 */
.detail-items {
  display: flex;
  flex-direction: column;
}

.detail-item {
  display: flex;
  margin-bottom: 24rpx;
}

.detail-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.payment-method {
  display: inline-block;
  margin-right: 24rpx;
}

/* 附加设施样式 */
.facility-items {
  display: flex;
  flex-wrap: wrap;
}

.facility-item {
  width: 33.33%;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

/* 所在小区样式 */
.community-value {
  font-size: 28rpx;
  color: #333;
}

/* 详细介绍样式 */
.introduction-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 其他信息样式 */
.other-items {
  display: flex;
  flex-direction: column;
}

.other-item {
  display: flex;
  margin-bottom: 16rpx;
}

.other-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #999;
}

.other-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 底部操作栏样式 */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120rpx;
  background-color: #ffffff;
  display: flex;
  border-top: 1rpx solid #e0e0e0;
  z-index: 100;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.action-item text {
  font-size: 24rpx;
  color: #333;
}

.collect {
  background-color: #ffffff;
}

.chat {
  background-color: #4ac924;
}

.chat text {
  color: #ffffff;
}

.call {
  background-color: #1890ff;
}

.call text {
  color: #ffffff;
} 