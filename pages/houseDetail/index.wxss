.detail-container {
  padding-bottom: 120rpx;
  background: linear-gradient(to bottom, #e0f4e8 0%, #ffffff 100%);
  min-height: 100vh;
}

.swiper-container {
  position: relative;
  width: 100%;
  height: 480rpx;
  margin: 20rpx 30rpx;
  width: calc(100% - 60rpx);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.swiper {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  overflow: hidden;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.image-counter {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.content-container {
  padding: 0 30rpx;
  margin-top: 30rpx;
  position: relative;
  z-index: 1;
}

.card {
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
  padding: 30rpx;
  overflow: hidden;
}

.house-header-card {
  margin-top: 0;
}

.house-header {
  padding: 0;
  background-color: transparent;
}

.house-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.house-price {
  font-size: 30rpx;
  color: #FF4D4F;
  font-weight: bold;
}

.price-value {
  font-size: 40rpx;
}

.house-tags {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0 0;
  gap: 16rpx;
  background-color: transparent;
}

.tag {
  margin-right: 0;
}
 

.payment-info {
  margin-top: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

 

.basic-info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx 40rpx;
  margin-top: 16rpx;
}

.info-grid-item {
  display: flex;
  flex-direction: column;
}
 
.facility-info {
  margin-bottom: 20rpx;
}

.elevator-info {
  display: flex;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
}

.facilities-list {
  display: flex;
  flex-wrap: wrap;
}

.facility-item {
  display: flex;
  align-items: center;
  width: 50%;
  margin-bottom: 20rpx;
}

.facility-item text {
  margin-left: 10rpx;
  font-size: 26rpx;
  color: #333;
}
 

.landlord-info {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.landlord-detail {
  margin-left: 20rpx;
}

.landlord-name {
  font-size: 30rpx;
  font-weight: bold;
}

.landlord-phone {
  font-size: 26rpx;
  color: #888;
  margin-top: 6rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  position: relative;
  margin-bottom: 20rpx;
}

.section-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.info-label {
  color: #888;
  font-size: 26rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-top: 4rpx;
}

.bottom-safe-area {
  height: 80rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.9);
  height: 110rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
  backdrop-filter: blur(10px);
  padding: 0 20rpx 10rpx;
}

.bottom-bar-content {
  display: flex;
  height: 100%;
  align-items: center;
}

.action-buttons {
  display: flex;
  flex: 1;
}

.action-button {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.action-button text {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

.appointment-button {
  width: 260rpx;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #0052D9;
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  border-radius: 40rpx;
}

@supports (padding-bottom: constant(safe-area-inset-bottom)) {
  .bottom-bar {
    padding-bottom: calc(10rpx + constant(safe-area-inset-bottom));
  }
}

@supports (padding-bottom: env(safe-area-inset-bottom)) {
  .bottom-bar {
    padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  }
}

.loading-container {
  padding: 100rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 600rpx;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
  min-height: 600rpx;
}

.error-text {
  color: #999;
  font-size: 28rpx;
  margin: 20rpx 0 30rpx;
} 