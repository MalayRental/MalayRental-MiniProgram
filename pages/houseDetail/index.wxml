<!-- 房源详情页 -->
<navigation-bar title="房源详情" back="{{true}}" background="#4ac924" color="#fff"></navigation-bar>
<view class="house-detail-container">
  <!-- 顶部轮播图 -->
  <swiper class="banner-swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="{{3000}}" duration="{{500}}" circular="{{true}}">
    <block wx:for="{{house.images}}" wx:key="*this">
      <swiper-item>
        <image src="{{item}}" class="banner-image" mode="aspectFill" bindtap="previewImage" data-current="{{item}}"></image>
      </swiper-item>
    </block>
  </swiper>

  <!-- 基本信息 -->
  <view class="info-section">
    <view class="house-name">{{house.houseName}}</view>
    <view class="house-price">{{house.price}} RM/月</view>
    
    <!-- 标签 -->
    <view class="tags-container">
      <block wx:for="{{house.tags}}" wx:key="*this">
        <view class="tag">{{item}}</view>
      </block>
    </view>
    
    <!-- 基本信息项 -->
    <view class="info-items">
      <view class="info-item">
        <view class="info-label">区域</view>
        <view class="info-value">{{house.area}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">朝向</view>
        <view class="info-value">{{house.orientation}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">面积</view>
        <view class="info-value">{{house.proportion}}m²</view>
      </view>
    </view>
  </view>

  <!-- 地址和入住时间 -->
  <view class="detail-section">
    <view class="section-title">详细信息</view>
    <view class="detail-items">
      <view class="detail-item">
        <view class="detail-label">详细地址</view>
        <view class="detail-value">{{house.address}}</view>
      </view>
      <view class="detail-item">
        <view class="detail-label">可入住时间</view>
        <view class="detail-value">{{house.moveInDate}}</view>
      </view>
      <view class="detail-item">
        <view class="detail-label">付款方式</view>
        <view class="detail-value">
          <text wx:for="{{house.paymentMethod}}" wx:key="*this" class="payment-method">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 附加设施 -->
  <view class="facility-section">
    <view class="section-title">附加设施</view>
    <view class="facility-items">
      <block wx:for="{{house.facilities}}" wx:key="*this">
        <view class="facility-item">{{item}}</view>
      </block>
    </view>
  </view>

  <!-- 所在小区 -->
  <view class="community-section">
    <view class="section-title">所在小区</view>
    <view class="community-value">{{house.community}}</view>
  </view>

  <!-- 详细介绍 -->
  <view class="introduction-section">
    <view class="section-title">详细介绍</view>
    <view class="introduction-content">{{house.introduction}}</view>
  </view>

  <!-- 其他信息 -->
  <view class="other-section">
    <view class="section-title">其他信息</view>
    <view class="other-items">
      <view class="other-item">
        <view class="other-label">中介费</view>
        <view class="other-value">{{house.brokerageFee}}</view>
      </view>
      <view class="other-item">
        <view class="other-label">上传时间</view>
        <view class="other-value">{{house.uploadTime}}</view>
      </view>
      <view class="other-item">
        <view class="other-label">最后更新</view>
        <view class="other-value">{{house.lastUpdate}}</view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-action-bar">
    <view class="action-item collect" bindtap="toggleCollect">
      <image src="{{isCollected ? '/assets/icons/star-filled.png' : '/assets/icons/star.png'}}" class="action-icon"></image>
      <text>收藏</text>
    </view>
    <view class="action-item chat" bindtap="onlineChat">
      <image src="/assets/icons/chat.png" class="action-icon"></image>
      <text>在线聊</text>
    </view>
    <view class="action-item call" bindtap="phoneCall">
      <image src="/assets/icons/phone.png" class="action-icon"></image>
      <text>电话聊</text>
    </view>
  </view>
</view> 