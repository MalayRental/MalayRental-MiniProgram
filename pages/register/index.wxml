<!-- 注册页面 -->
<navigation-bar title="账号注册" back="{{true}}" background="#4ac924" color="#ffffff"></navigation-bar>
<view class="register-container">
  <!-- 顶部标题 -->
  <view class="register-title">
    <text class="title-text">欢迎注册马来租房</text>
    <text class="subtitle-text">请填写以下信息完成注册</text>
  </view>
  
  <!-- 注册表单 -->
  <view class="register-form">
    <!-- 手机号输入 -->
    <view class="input-item">
      <view class="input-label">手机号</view>
      <view class="input-content {{phoneFocus ? 'focus' : ''}}">
        <input 
          class="form-input" 
          placeholder="请输入手机号" 
          placeholder-class="input-placeholder"
          type="number"
          maxlength="11"
          value="{{phone}}"
          bindinput="handlePhoneInput"
          bindfocus="handlePhoneFocus"
          bindblur="handlePhoneBlur"
        ></input>
      </view>
    </view>
    
    <!-- 用户昵称输入 -->
    <view class="input-item">
      <view class="input-label">用户昵称</view>
      <view class="input-content {{nicknameFocus ? 'focus' : ''}}">
        <input 
          class="form-input" 
          placeholder="请输入昵称" 
          placeholder-class="input-placeholder"
          type="text"
          maxlength="20"
          value="{{nickname}}"
          bindinput="handleNicknameInput"
          bindfocus="handleNicknameFocus"
          bindblur="handleNicknameBlur"
        ></input>
      </view>
    </view>
    
    <!-- 密码输入 -->
    <view class="input-item">
      <view class="input-label">设置密码</view>
      <view class="input-content {{passwordFocus ? 'focus' : ''}}">
        <input 
          class="form-input" 
          placeholder="请输入密码（6-20位字母数字组合）" 
          placeholder-class="input-placeholder"
          type="password"
          value="{{password}}"
          bindinput="handlePasswordInput"
          bindfocus="handlePasswordFocus"
          bindblur="handlePasswordBlur"
        ></input>
      </view>
    </view>
    
    <!-- 确认密码输入 -->
    <view class="input-item">
      <view class="input-label">确认密码</view>
      <view class="input-content {{confirmPasswordFocus ? 'focus' : ''}}">
        <input 
          class="form-input" 
          placeholder="请再次输入密码" 
          placeholder-class="input-placeholder"
          type="password"
          value="{{confirmPassword}}"
          bindinput="handleConfirmPasswordInput"
          bindfocus="handleConfirmPasswordFocus"
          bindblur="handleConfirmPasswordBlur"
        ></input>
      </view>
    </view>
    
    <!-- 注册按钮 -->
    <button class="register-button" bindtap="handleRegister" hover-class="button-hover">注册</button>
    
    <!-- 底部链接 -->
    <view class="bottom-links">
      <text>已有账号？</text>
      <view class="link" bindtap="navigateToLogin">立即登录</view>
    </view>
  </view>
  
  <!-- 底部协议 -->
  <view class="agreement">
    <checkbox-group bindchange="handleAgreementChange">
      <checkbox value="agree" checked="{{isAgree}}" color="#4ac924"></checkbox>
    </checkbox-group>
    <view class="agreement-text">
      注册即代表同意
      <text class="link-text" bindtap="navigateToUserAgreement">《用户协议》</text>
      和
      <text class="link-text" bindtap="navigateToPrivacyPolicy">《隐私政策》</text>
    </view>
  </view>
</view> 