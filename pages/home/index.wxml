<!-- 首页 -->
<navigation-bar title="马来租房" back="{{false}}" background="#4ac924" color="#ffffff"></navigation-bar>
<view class="home-container">
  <!-- 搜索框 -->
  <view class="search-container">
    <view class="search-box">
      <icon type="search" size="16" color="#999"></icon>
      <input 
        class="search-input" 
        placeholder="搜索房源名称" 
        placeholder-class="search-placeholder"
        value="{{searchValue}}"
        bindinput="handleSearchInput"
        confirm-type="search"
      ></input>
      <view class="search-clear" bindtap="clearSearch" wx:if="{{searchValue}}">
        <icon type="clear" size="16" color="#999"></icon>
      </view>
    </view>
  </view>
  
  <!-- 轮播图 -->
  <swiper class="banner-swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="{{3000}}" duration="{{500}}" circular="{{true}}">
    <block wx:for="{{banners}}" wx:key="id">
      <swiper-item>
        <image 
          src="{{item.image}}" 
          class="banner-image" 
          mode="aspectFill"
          bindtap="handleBannerTap"
          data-index="{{index}}"
        ></image>
      </swiper-item>
    </block>
  </swiper>

  <!-- 筛选区域 -->
  <view class="filter-container">
    <!-- 位置筛选 -->
    <view class="filter-item">
      <picker mode="selector" range="{{filters.locations}}" value="{{filters.locations.indexOf(filters.selectedLocation)}}" bindchange="handleLocationChange">
        <view class="filter-selector">
          <text>{{filters.selectedLocation}}</text>
          <view class="arrow-down"></view>
        </view>
      </picker>
    </view>

    <!-- 户型筛选 -->
    <view class="filter-item">
      <picker mode="selector" range="{{filters.rooms}}" value="{{filters.rooms.indexOf(filters.selectedRoom)}}" bindchange="handleRoomChange">
        <view class="filter-selector">
          <text>{{filters.selectedRoom}}</text>
          <view class="arrow-down"></view>
        </view>
      </picker>
    </view>

    <!-- 租金筛选 -->
    <view class="filter-item">
      <picker mode="selector" range="{{filters.prices}}" value="{{filters.prices.indexOf(filters.selectedPrice)}}" bindchange="handlePriceChange">
        <view class="filter-selector">
          <text>{{filters.selectedPrice}}</text>
          <view class="arrow-down"></view>
        </view>
      </picker>
    </view>

    <!-- 排序筛选 -->
    <view class="filter-item">
      <picker mode="selector" range="{{filters.sorts}}" value="{{filters.sorts.indexOf(filters.selectedSort)}}" bindchange="handleSortChange">
        <view class="filter-selector">
          <text>{{filters.selectedSort}}</text>
          <view class="arrow-down"></view>
        </view>
      </picker>
    </view>
  </view>

  <!-- 房源列表 -->
  <scroll-view scroll-y="{{true}}" class="house-list">
    <block wx:for="{{filteredHouses}}" wx:key="id">
      <view class="house-item" bindtap="navigateToDetail" data-houseid="{{item.id}}">
        <!-- 房源封面 -->
        <image src="{{item.coverImage}}" class="house-cover" mode="aspectFill"></image>
        
        <!-- 房源信息 -->
        <view class="house-info">
          <!-- 名称 -->
          <view class="house-name">{{item.houseName}}</view>
          
          <!-- 区域 -->
          <view class="house-area">{{item.area}}</view>
          
          <!-- 详细信息：户型、面积、朝向 -->
          <view class="house-details">
            <text class="house-orientation">{{item.orientation}}</text>
            <text class="house-proportion">{{item.proportion}}m²</text>
          </view>
          
          <!-- 价格 -->
          <view class="house-price">{{item.price}} RM/月</view>
        </view>
      </view>
    </block>
    
    <!-- 无数据提示 -->
    <view class="empty-state" wx:if="{{filteredHouses.length === 0}}">
      <image src="/assets/images/empty.png" class="empty-image"></image>
      <text class="empty-text">未找到符合条件的房源</text>
    </view>
  </scroll-view>
</view> 