.home-container {
  padding-bottom: 220rpx;
  background: linear-gradient(to bottom, #e0f4e8 0%, #ffffff 100%);
}

.search-container {
  padding: 20rpx 30rpx 16rpx;
  background-color: #e0f4e8;
  position: fixed;
  width: 100%;
  box-sizing: border-box;
  z-index: 100;
  box-shadow: none;
}

/* 占位容器，防止内容被固定的搜索框遮挡 */
.search-placeholder {
  height: 110rpx; /* 搜索框高度 + 上下padding */
}

.swiper-container {
  margin: 20rpx 20rpx;
  height: 460rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.swiper-container swiper {
  height: 460rpx;
}

.swiper-image {
  width: 100%;
  height: 460rpx;
  display: block;
}

.filter-container {
  margin: 0 20rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.8);
  position: relative;
  z-index: 90;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.filter-tabs {
  display: flex;
  height: 88rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.filter-tab {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  position: relative;
}

.filter-tab text {
  margin-right: 6rpx;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-tab.active {
  color: #0052D9;
}

.filter-panel-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 110;
}

.filter-panel {
  position: absolute;
  top: 88rpx;
  background-color: rgba(255, 255, 255, 0.95);
  z-index: 111;
  box-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.1);
  max-height: 600rpx;
  overflow-y: auto;
  border-radius: 20rpx;
  margin: 0 20rpx;
  width: calc(100% - 40rpx);
  left: 0;
}

.filter-options {
  padding: 20rpx 30rpx;
  display: flex;
  flex-wrap: wrap;
}

.filter-option {
  width: calc(33.33% - 20rpx);
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: rgba(245, 245, 245, 0.7);
  margin: 10rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #333;
}

.filter-option.active {
  background-color: rgba(236, 242, 254, 0.9);
  color: #0052D9;
}

.house-list {
  background-color: transparent;
}

.house-item {
  padding: 20rpx 30rpx;
  margin: 0 20rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.house-item-content {
  display: flex;
  margin-bottom: 0;
  height: 220rpx;
}
 
.house-img-container {
  width: 220rpx;
  height: 220rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.house-img {
  width: 100%;
  height: 100%;
}

.house-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 220rpx;
  justify-content: space-between;
  overflow: hidden;
  padding-bottom: 0;
}

.house-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  line-height: 44rpx;
}

.house-price {
  color: #FF4D4F;
  font-weight: bold;
  font-size: 38rpx;
}

.house-info-line {
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.house-tags {
  display: flex;
  flex-wrap: nowrap;
  margin-bottom: 0;
  overflow: hidden;
  white-space: nowrap;
}

.tag {
  margin-right: 8rpx;
  font-size: 26rpx !important;
  padding: 4rpx 14rpx !important;
  flex-shrink: 0;
  display: inline-block;
}

.t-divider {
  margin: 5rpx 0 !important;
}

/* 自定义搜索组件样式 */
.search-container .t-search {
  background-color: rgba(255, 255, 255, 0.8) !important;
  border-radius: 36rpx !important;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
}

.search-container .t-search__input-container {
  height: 72rpx !important;
}

.loading-container {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  text-align: center;
}

.error-text {
  color: #999;
  font-size: 28rpx;
  margin: 20rpx 0 30rpx;
}

.empty-container {
  padding: 40rpx 0;
} 