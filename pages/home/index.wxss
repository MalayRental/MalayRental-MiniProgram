/* 首页样式 */
.home-container {
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #4ac924 0%, #f2faf2 30%, #f6f6f6 100%);
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 轮播图样式 */
.banner-swiper {
  width: calc(100% - 48rpx);
  height: 420rpx;
  margin: 8rpx 24rpx 16rpx;
  margin-bottom: 11px;
  border-radius: 12rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 筛选区域样式 */
.filter-container {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 80rpx;
  background-color: #ffffff;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  border-radius: 12rpx;
  width: calc(100% - 48rpx);
}

.filter-item {
  flex: 1;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.filter-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20rpx;
  bottom: 20rpx;
  width: 1rpx;
  background-color: #e0e0e0;
}

.filter-selector {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333;
}

.arrow-down {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid #999;
  margin-left: 8rpx;
}

/* 房源列表样式 */
.house-list {
  flex: 1;
  padding: 0 24rpx;
  padding-bottom: 64px;
  padding-top: 4px;
  width: 100%;
  box-sizing: border-box;
}

.house-item {
  display: flex;
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
  height: 220rpx;
}

.house-cover {
  width: 240rpx;
  height: 100%;
  flex-shrink: 0;
  object-fit: cover;
}

.house-info {
  flex: 1;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: calc(100% - 240rpx);
  box-sizing: border-box;
  overflow: hidden;
}

.house-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.house-area {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.house-details {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.house-orientation {
  margin-right: 16rpx;
}

.house-proportion {
  position: relative;
  padding-left: 16rpx;
}

.house-proportion::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 24rpx;
  background-color: #e0e0e0;
}

.house-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
}

/* 搜索框样式 */
.search-container {
  padding: 24rpx;
  background: transparent;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  height: 72rpx;
  border-radius: 36rpx;
  padding: 0 24rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  margin-left: 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  line-height: 72rpx;
}

.search-placeholder {
  color: #999;
}

.search-clear {
  padding: 10rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
} 