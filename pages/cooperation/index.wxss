/* pages/cooperation/index.wxss */
.cooperation-container {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: linear-gradient(to bottom, #e0f4e8 0%, #ffffff 100%);
  animation: fadeIn 0.5s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 头部区域 */
.header-section {
  width: 100%;
  height: 300rpx;
  position: relative;
  overflow: hidden;
}

.header-image {
  width: 100%;
  height: 100%;
}

.header-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-text {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 选项卡样式 */
.tab-container {
  margin: 20rpx 0;
  background-color: #fff;
}

.custom-tabs {
  --td-tab-item-color: #666 !important;
  --td-tab-item-active-color: #0052D9 !important;
  --td-tab-item-active-border-color: #0052D9 !important;
  --td-tab-track-color: #0052D9 !important;
}

.tab-content {
  padding: 30rpx;
}

.content-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #0052D9;
  margin-bottom: 30rpx;
  text-align: center;
}

/* 权益部分 */
.benefit-section, .process-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  height: 30rpx;
  width: 6rpx;
  background-color: #0052D9;
  border-radius: 3rpx;
}

.benefit-list {
  padding: 10rpx 0;
}

.benefit-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.benefit-icon {
  margin-right: 15rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.benefit-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  flex: 1;
}

/* 流程部分 */
.process-list {
  display: flex;
  flex-direction: column;
  padding: 10rpx 0;
}

.process-item {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
}

.process-number {
  width: 50rpx;
  height: 50rpx;
  background-color: #0052D9;
  color: #fff;
  border-radius: 50%;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.process-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  flex: 1;
}

/* 联系卡片 */
.contact-card {
  margin: 30rpx 30rpx;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.contact-list {
  padding: 10rpx 0;
}

.contact-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.contact-text {
  font-size: 28rpx;
  color: #333;
  margin-left: 15rpx;
}

.copy-hint {
  font-size: 24rpx;
  color: #999;
}

/* 表单卡片 */
.form-card {
  margin: 30rpx 30rpx;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.form-content {
  padding: 10rpx 0;
}

/* 上传图片区域 */
.upload-section {
  margin-top: 30rpx;
  margin-bottom: 40rpx;
}

.upload-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.upload-content {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.upload-item {
  width: 160rpx;
  height: 160rpx;
  position: relative;
  border-radius: 10rpx;
  overflow: hidden;
}

.upload-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.delete-icon {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  z-index: 2;
}

.upload-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ddd;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f9f9f9;
}

/* 提交按钮 */
.submit-section {
  margin-top: 30rpx;
} 