.message-container {
  background: linear-gradient(to bottom, #e0f4e8 0%, #ffffff 100%);
  min-height: 100vh;
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 已登录容器 */
.logged-in-container {
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
  /* 使用flex布局让内容自动填满空间 */
  flex: 1;
}

/* 未登录状态样式 */
.not-login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.not-login-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 50rpx;
}

.not-login-image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 40rpx;
}

.not-login-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.not-login-desc {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  margin-bottom: 60rpx;
  line-height: 1.6;
}

.login-button {
  width: 100%;
  border-radius: 12rpx !important;
  height: 90rpx !important;
  font-size: 32rpx !important;
  margin-top: 20rpx;
}

/* 网络错误提示 */
.network-error {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  background-color: rgba(250, 81, 81, 0.1);
  color: #fa5151;
  font-size: 24rpx;
  width: 100%;
}

.network-error text {
  margin-left: 8rpx;
}

/* 已登录状态样式 */
.message-list {
  background-color: transparent;
  padding-top: 10rpx;
  width: 100%;
  box-sizing: border-box;
  flex: 1;
  /* 自动增长以填充空间，确保内容紧贴底部tab */
  display: flex;
  flex-direction: column;
}

.message-item {
  display: flex;
  padding: 20rpx 30rpx;
  border-bottom: none;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.8);
  margin: 0 20rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

/* 最后一个消息项底部间距给tab-bar */
.last-message-item {
  margin-bottom: 10rpx;
}

.message-item-hover {
  background-color: rgba(240, 240, 240, 0.9);
  transform: scale(0.99);
}

.avatar-container {
  position: relative;
  margin-right: 24rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  background-color: #ff4d4f;
  color: white;
  font-size: 22rpx;
  border-radius: 16rpx;
  text-align: center;
  padding: 0 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 50rpx;
}

.message-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

.message-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  width: 100%;
}

.sender-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 24rpx;
}

.message-time {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
}

.message-text {
  font-size: 28rpx;
  color: #666;
  width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 40rpx;
}

.message-text.no-message {
  color: #999;
  font-style: italic;
}

.empty-message {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 50vh;
  color: #999;
  font-size: 30rpx;
  background-color: transparent;
}

.empty-message text {
  color: #999;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.empty-desc {
  font-size: 24rpx !important;
  color: #aaa !important;
  margin-top: 10rpx !important;
}

.loading-container {
  padding: 30rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 30rpx;
  text-align: center;
}

.error-text {
  color: #999;
  font-size: 28rpx;
  margin: 20rpx 0 30rpx;
}