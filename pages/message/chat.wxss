.chat-container {
  background: linear-gradient(to bottom, #e0f4e8 0%, #ffffff 100%);
  min-height: 100vh;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* 登录提示样式 */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.login-icon {
  margin-bottom: 40rpx;
  width: 160rpx;
  height: 160rpx;
  background-color: rgba(0, 82, 217, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 60rpx;
}

.loading-container {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  text-align: center;
}

.error-text {
  color: #999;
  font-size: 28rpx;
  margin: 20rpx 0 30rpx;
}

.message-list {
  padding: 24rpx 30rpx;
  margin-bottom: 130rpx;
}

.message-item {
  margin-bottom: 36rpx;
  display: flex;
  flex-direction: column;
}

.message-info {
  display: flex;
  flex-direction: column;
  max-width: 78%;
}

.message-item.self .message-info {
  align-self: flex-end;
  align-items: flex-end;
}

.message-item.other .message-info {
  align-self: flex-start;
  align-items: flex-start;
}

.message-bubble {
  padding: 20rpx 28rpx;
  border-radius: 22rpx;
  word-break: break-all;
  margin-bottom: 10rpx;
  min-width: 90rpx;
}

/* 图片消息气泡样式 */
.message-bubble.image-bubble {
  padding: 10rpx;
  background-color: transparent !important;
  overflow: hidden;
}

.message-item.self .message-bubble {
  background-color: #0052D9;
  color: #fff;
  border-bottom-right-radius: 6rpx;
}

.message-item.other .message-bubble {
  background-color: rgba(255, 255, 255, 0.9);
  color: #333;
  border-bottom-left-radius: 6rpx;
}

/* 图片消息样式 */
.message-image {
  width: 320rpx;
  max-width: 100%;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.message-content {
  font-size: 32rpx;
  line-height: 1.5;
}

.message-time {
  font-size: 26rpx;
  color: #999;
  margin: 0 8rpx;
}

.empty-chat {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 300rpx;
  color: #999;
  font-size: 28rpx;
  text-align: center;
  padding: 0 60rpx;
}

.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  z-index: 100;
}

/* 图片按钮样式 */
.image-button {
  width: 80rpx;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 10rpx;
}

.message-input {
  flex: 1;
  height: 88rpx;
  background-color: rgba(240, 240, 240, 0.5);
  border-radius: 44rpx;
  padding: 0 34rpx;
  font-size: 30rpx;
}

.send-button {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-left: 20rpx;
}

.send-button.active {
  transform: scale(1.05);
} 

/* 卡片消息样式 */
.message-card {
  width: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: linear-gradient(to bottom, #ffffff, #f9fbff);
  box-shadow: 0 6rpx 24rpx rgba(0, 82, 217, 0.08), 0 1rpx 4rpx rgba(0,0,0,0.05);
  margin: 12rpx 0;
  transition: all 0.3s ease;
  position: relative;
}

.message-item.self .message-card {
  align-self: flex-end;
}

.message-item.other .message-card {
  align-self: flex-start;
}

.message-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 82, 217, 0.06);
}

.card-image {
  width: 100%;
  height: 200rpx;
  object-fit: cover;
  display: block;
  background: #f0f4f9;
  position: relative;
}

.card-content {
  padding: 20rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  background: rgba(255, 255, 255, 0.95);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
  margin-bottom: 12rpx;
  line-height: 1.2;
  max-width: 94%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}

.card-desc {
  font-size: 30rpx;
  color: #FF4D4F;
  font-weight: bold;
  display: flex;
  align-items: center;
  letter-spacing: 0.5rpx;
}