<view class="message-container">
  <!-- 自定义导航栏 -->
  <custom-navbar title="消息" solidGradient="{{true}}" showHome="{{true}}" bind:heightChange="onNavBarHeightChange"></custom-navbar>
  
  <!-- 未登录状态 -->
  <view class="not-login-container" wx:if="{{!isLoggedIn}}" style="margin-top: {{navBarHeight}}rpx;">
    <view class="not-login-content">
      <image src="/images/message-empty.png" class="not-login-image" mode="aspectFit"></image>
      <view class="not-login-title">登录后查看您的消息</view>
      <view class="not-login-desc">与房东沟通、收到看房通知、了解最新消息</view>
      <t-button theme="primary" size="large" class="login-button" bindtap="goToLogin">立即登录</t-button>
    </view>
  </view>
  
  <!-- 已登录状态 -->
  <view class="logged-in-container" wx:else style="margin-top: {{navBarHeight}}rpx;">
    <!-- 网络错误提示 -->
    <view class="network-error" wx:if="{{hasNetworkError}}">
      <t-icon name="error-circle-filled" size="32rpx" color="#fa5151" />
      <text>网络连接失败，请检查网络设置</text>
    </view>
    
    <!-- 加载中 -->
    <view class="loading-container" wx:if="{{loading && !isRefreshing}}">
      <t-loading theme="circular" size="40rpx" loading="{{loading}}" />
    </view>
    
    <!-- 错误提示 -->
    <view class="error-container" wx:if="{{error && !loading}}">
      <t-icon name="error-circle" size="80rpx" />
      <view class="error-text">{{error}}</view>
      <t-button size="small" theme="primary" bindtap="fetchConversations">重新加载</t-button>
    </view>
    
    <!-- 消息列表 -->
    <view class="message-list">
      <block wx:if="{{messageList.length > 0}}">
        <view 
          class="message-item {{index === messageList.length - 1 ? 'last-message-item' : ''}}" 
          wx:for="{{messageList}}" 
          wx:key="id" 
          bindtap="onTapMessage" 
          data-id="{{item.id}}"
          data-name="{{item.sender.name}}"
          hover-class="message-item-hover"
        >
          <view class="avatar-container">
            <t-avatar image="{{item.sender.avatar}}" size="medium" />
            <view class="badge" wx:if="{{item.unread > 0}}">{{item.displayUnread}}</view>
          </view>
          <view class="message-content">
            <view class="message-header">
              <text class="sender-name">{{item.sender.name}}</text>
              <text class="message-time">{{item.lastTime}}</text>
            </view>
            <text class="message-text {{!item.lastMessage ? 'no-message' : ''}}">
              {{item.lastMessage || '暂无消息内容'}}
            </text>
          </view>
        </view>
      </block>
      <view class="empty-message" wx:if="{{!loading && !error && messageList.length === 0}}">
        <t-icon name="chat" size="120rpx" color="#BBBBBB" />
        <text>暂无消息</text>
        <text class="empty-desc">预约看房后，可以在这里与房东沟通</text>
      </view>
    </view>
  </view>
</view> 