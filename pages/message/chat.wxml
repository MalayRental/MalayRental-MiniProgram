<view class="chat-container">
  <!-- 自定义导航栏 -->
  <custom-navbar 
    title="{{chatName}}"
    showBack="{{true}}" 
    solidGradient="{{true}}" 
    bind:heightChange="onNavBarHeightChange"
  ></custom-navbar>
  
  <!-- 未登录提示 -->
  <view class="login-prompt" wx:if="{{!isLoggedIn}}">
    <view class="login-icon">
      <t-icon name="user" size="80rpx" color="#0052D9" />
    </view>
    <view class="login-text">请登录后使用在线聊天功能</view>
    <t-button theme="primary" size="medium" bindtap="goToLogin">去登录</t-button>
  </view>
  
  <!-- 登录状态下的内容 -->
  <block wx:if="{{isLoggedIn}}">
    <!-- 加载中提示 -->
    <view class="loading-container" wx:if="{{loading}}">
      <t-loading theme="circular" size="40rpx" loading="{{loading}}" />
    </view>
    
    <!-- 错误提示 -->
    <view class="error-container" wx:if="{{error && !loading}}">
      <t-icon name="error-circle" size="80rpx" />
      <view class="error-text">{{error}}</view>
      <t-button size="small" theme="primary" bindtap="fetchChatMessages">重新加载</t-button>
    </view>
  
    <!-- 聊天消息列表 -->
    <view class="message-list" id="message-list" style="margin-top: {{navBarHeight ? 15 : 15}}rpx;" wx:if="{{messages.length > 0 && !loading}}">
      <block wx:for="{{messages}}" wx:key="id">
        <view class="message-item {{item.isSelf ? 'self' : 'other'}}">
          <view class="message-info">
            <!-- 根据消息类型显示不同内容 -->
            <view class="message-bubble {{item.isImage ? 'image-bubble' : ''}}">
              <!-- 文本消息 -->
              <text wx:if="{{!item.isImage}}" class="message-content">{{item.content}}</text>
              <!-- 图片消息 -->
              <image 
                wx:if="{{item.isImage}}" 
                class="message-image" 
                src="{{item.imageUrl}}" 
                mode="widthFix" 
                lazy-load="true"
                binderror="onImageError"
                bindtap="previewImage"
                data-url="{{item.imageUrl}}"
              ></image>

           
            </view>
            <text class="message-time">{{item.time}}</text>
          </view>

        </view>
   
      </block>
     
    
    </view>
  
    <!-- 空消息提示 -->
    <view class="empty-chat" wx:if="{{!loading && !error && messages.length === 0}}">
      <text>暂无消息记录，发送第一条消息开始聊天吧</text>
    </view>
    
    <!-- 底部输入框 -->
    <view class="input-area">
      <!-- 添加图片按钮 -->
      <view class="image-button" bindtap="sendImageMessage">
        <t-icon name="image" size="44rpx" color="#888888" />
      </view>
      <input 
        type="text" 
        class="message-input" 
        placeholder="输入消息..." 
        value="{{inputValue}}" 
        bindinput="onInputChange"
        confirm-type="send"
        bindconfirm="sendMessage"
        disabled="{{sending}}"
      />
      <view class="send-button {{inputValue ? 'active' : ''}}" bindtap="sendMessage">
        <t-icon wx:if="{{!sending}}" name="send" size="44rpx" color="{{inputValue ? '#0052D9' : '#BBBBBB'}}" />
        <t-loading wx:else theme="circular" size="24rpx" />
      </view>
    </view>
  </block>
</view> 