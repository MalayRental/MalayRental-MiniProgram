/* 头像区域 */
.avatar-container {
  display: flex;
  justify-content: center;
  margin: 60rpx 0;
}

.avatar-wrapper {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 90rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-edit-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
}

.avatar-edit-mask text {
  color: #fff;
  font-size: 24rpx;
}

/* 信息区域 */
.info-container {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 60rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.info-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.info-input {
  flex: 1;
  height: 40rpx;
  min-height: 40rpx;
  font-size: 28rpx;
  color: #333;
}

.info-picker {
  flex: 1;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
}

/* 按钮区域 */
.button-container {
  display: flex;
  justify-content: center;
  margin-top: auto;
}

.edit-button {
  width: 80%;
  height: 80rpx;
  background-color: #1296db;
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.cancel-button,
.save-button {
  width: 40%;
  height: 80rpx;
  font-size: 30rpx;
  border-radius: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 20rpx;
}

.cancel-button {
  background-color: #f5f5f5;
  color: #666;
}

.save-button {
  background-color: #1296db;
  color: #fff;
} 