/* 渐变背景和卡片容器样式 */
.page-container {
  padding: 30rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #4ac924 0%, #f2faf2 30%, #f6f6f6 100%);
}

.content {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

