/* map.wxss */
.map-container {
  width: 100%;
  height: 100vh;
  position: relative;
}

/* 加载状态 */
.loading-container {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(255, 255, 255, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 50;
}

.loading-box {
  background-color: rgba(0, 0, 0, 0.7);
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #1aad19;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: white;
  font-size: 28rpx;
}

/* 房源信息面板 */
.house-info-panel {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  background-color: #fff;
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 -4rpx 10rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  z-index: 100;
  max-height: 80%;
  transform: translateY(100%);
}

.house-info-panel.show {
  transform: translateY(0);
}

/* 面板头部 */
.panel-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.house-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 48rpx;
  color: #999;
  padding: 0 10rpx;
}

/* 面板内容 */
.panel-body {
  padding: 30rpx;
  overflow-y: auto;
  max-height: calc(80vh - 100rpx);
}

/* 房源图片 */
.house-image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.house-image image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 价格区域 */
.price-box {
  margin-bottom: 30rpx;
}

.price {
  font-size: 44rpx;
  color: #ff5a5f;
  font-weight: bold;
}

.price-unit {
  font-size: 28rpx;
  color: #666;
  margin-left: 5rpx;
}

/* 房屋信息 */
.house-info {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.info-item {
  width: 50%;
  margin-bottom: 15rpx;
  display: flex;
}

.full-width {
  width: 100%;
}

.item-label {
  color: #888;
  font-size: 28rpx;
  min-width: 80rpx;
}

.item-value {
  color: #333;
  font-size: 28rpx;
  flex: 1;
}

/* 查看详情按钮 */
.detail-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #1aad19;
  color: white;
  border-radius: 40rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
  text-align: center;
  padding: 0;
} 