/* 隐私政策页面样式 */
.page-container {
  padding: 30rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #4ac924 0%, #f2faf2 30%, #f6f6f6 100%);
}

.content {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.header-image {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.policy-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #4ac924;
}

.section-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  text-align: justify;
}

.section-content-item {
  margin-bottom: 16rpx;
}

.placeholder {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.last-update {
  font-size: 24rpx;
  color: #999;
  text-align: right;
  margin-top: 30rpx;
} 