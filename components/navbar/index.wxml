<view class="custom-navbar {{bgGradient ? 'gradient-bg' : ''}} {{solidGradient ? 'solid-gradient-bg' : ''}}" style="background-color: {{backgroundColor}};">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  
  <!-- 导航栏内容 -->
  <view class="nav-content" style="height: {{navBarHeight}}px;">
    <view class="nav-left">
      <view wx:if="{{showBack}}" bindtap="goBack">
        <t-icon name="chevron-left" size="48rpx" color="{{textColor}}" />
      </view>
      <view wx:elif="{{showHome}}" bindtap="goHome">
        <t-icon name="home" size="44rpx" color="{{textColor}}" />
      </view>
    </view>
    
    <view class="nav-center" style="height: {{menuButtonHeight}}px; top: {{menuButtonTop}}px; padding-bottom: 4rpx;">
      <text style="color: {{textColor}};">{{title}}</text>
    </view>
    
    <view class="nav-right"></view>
  </view>
</view>

<!-- 导航栏占位，防止页面内容被遮挡 -->
<view class="navbar-placeholder" style="height: {{statusBarHeight + navBarHeight}}px;"></view> 