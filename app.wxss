/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 

page {
  --td-brand-color: #0052D9;
  --td-brand-color-active: #003CAB;
  --td-brand-color-disabled: #B7D0FF;
  --td-brand-color-light: #ECF2FE;
  --td-brand-color-focus: rgba(0, 82, 217, 0.2);
  --td-warning-color: #FAAD14;
  --td-warning-color-active: #E58A06;
  --td-warning-color-disabled: #FFC672;
  --td-warning-color-light: #FFF7E3;
  --td-warning-color-focus: rgba(250, 173, 20, 0.2);
  --td-error-color: #FF4D4F;
  --td-error-color-active: #D32E30;
  --td-error-color-disabled: #FFB8B8;
  --td-error-color-light: #FFECEC;
  --td-error-color-focus: rgba(255, 77, 79, 0.2);
  --td-success-color: #52C41A;
  --td-success-color-active: #448816;
  --td-success-color-disabled: #8FDCA8;
  --td-success-color-light: #E5F8E5;
  --td-success-color-focus: rgba(82, 196, 26, 0.2);
  
  background-color: #f6f6f6;
} 
